{
  "expo": {
    "name": "PocketPics",
    "slug": "pocketpics",
    "scheme": "pocketpics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.pocketpics.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PocketPics transforme les photos de ta galerie en cartes à collectionner.",
        "NSCameraUsageDescription": "La caméra sert à scanner le QR code d'un échange.",
        "NSLocalNetworkUsageDescription": "Le réseau local sert à échanger des cartes avec un joueur à côté de toi.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pocketpics.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#09090B"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PocketPics transforme les photos de ta galerie en cartes à collectionner.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner le QR code d'un échange.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-updates",
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false }],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
